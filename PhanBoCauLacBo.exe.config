<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu hình .NET Framework cho tệp PhanBoCauLacBo.exe.
  PHẢI nằm CẠNH tệp .exe (không phải trong _internal/) thì .NET mới đọc.

  VÌ SAO CẦN:
  Trên Windows, pywebview đi qua pythonnet -> .NET Framework. Khi người
  dùng tải bản .zip về rồi giải nén, Windows gắn dấu "tải từ Internet"
  vào từng tệp. .NET Framework mặc định TỪ CHỐI nạp assembly mang dấu
  đó — và đó đúng là triệu chứng đang gặp:

      Failed to resolve Python.Runtime.Loader.Initialize
      from ...\_internal\pythonnet\runtime\Python.Runtime.dll

  Thông báo nêu rõ đường dẫn, nghĩa là tệp CÓ ở đó và .NET tìm thấy —
  chỉ là không chịu nạp. loadFromRemoteSources gỡ đúng rào cản đó.

  Đây là hai lớp cùng chữa một nguyên nhân: chan_doan.go_dau_tai_ve()
  xoá dấu khỏi từng tệp lúc khởi động, còn tệp này bảo .NET đừng bận tâm
  tới dấu ngay từ đầu. Lớp nào ăn trước cũng được.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
